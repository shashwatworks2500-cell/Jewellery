# Skills CLI staging directory.
# `npx skills add` stages packages here and then copies them into
# .claude/skills/, which is what Claude Code actually reads and what this
# repository tracks. .agents/ is a byte-for-byte duplicate (~3.2 MB) and is
# regenerated automatically by scripts/setup-claude-skills.sh, so it is not
# committed. Nothing in .claude/skills/ links to it.
.agents/

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
next-env.d.ts

# Environment — never commit secrets of any kind
.env
.env.*
!.env.example

# Vercel
.vercel

# Editor / OS noise
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
.vscode/

# TypeScript
*.tsbuildinfo
.env*
